<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>title</key>
	<string>悬浮网速</string>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>悬浮窗</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>启用悬浮网速</string>
			<key>key</key>
			<string>enabled</string>
			<key>defaults</key>
			<string>cn.qwr136.netspeed</string>
			<key>default</key>
			<true/>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>显示下载速度</string>
			<key>key</key>
			<string>showDownload</string>
			<key>defaults</key>
			<string>cn.qwr136.netspeed</string>
			<key>default</key>
			<true/>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>显示上传速度</string>
			<key>key</key>
			<string>showUpload</string>
			<key>defaults</key>
			<string>cn.qwr136.netspeed</string>
			<key>default</key>
			<true/>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>外观</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSLinkListCell</string>
			<key>label</key>
			<string>字体大小</string>
			<key>key</key>
			<string>fontSize</string>
			<key>defaults</key>
			<string>cn.qwr136.netspeed</string>
			<key>default</key>
			<integer>12</integer>
			<key>detail</key>
			<string>PSListItemsController</string>
			<key>validTitles</key>
			<array>
				<string>小</string>
				<string>中</string>
				<string>大</string>
				<string>特大</string>
			</array>
			<key>validValues</key>
			<array>
				<integer>10</integer>
				<integer>12</integer>
				<integer>14</integer>
				<integer>18</integer>
			</array>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSLinkListCell</string>
			<key>label</key>
			<string>背景透明度</string>
			<key>key</key>
			<string>bgOpacity</string>
			<key>defaults</key>
			<string>cn.qwr136.netspeed</string>
			<key>default</key>
			<real>0.5</real>
			<key>detail</key>
			<string>PSListItemsController</string>
			<key>validTitles</key>
			<array>
				<string>透明</string>
				<string>淡</string>
				<string>中</string>
				<string>深</string>
			</array>
			<key>validValues</key>
			<array>
				<real>0.0</real>
				<real>0.3</real>
				<real>0.5</real>
				<real>0.75</real>
			</array>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>footerText</key>
			<string>在屏幕上单指拖动悬浮窗可移动位置；双击悬浮窗恢复默认位置。修改后立即生效，无需重启。</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>重置悬浮窗位置</string>
			<key>action</key>
			<string>resetPosition</string>
			<key>isDestructive</key>
			<true/>
		</dict>
	</array>
</dict>
</plist>
