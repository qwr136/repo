<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>title</key>
    <string>微信输入法工具栏</string>
    <key>items</key>
    <array>
        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
            <key>label</key>
            <string>工具栏</string>
            <key>footerText</key>
            <string>自定义按钮数量（1–30）与左右边距（0–200pt），数值会被强制钳制以防键盘崩溃。</string>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSNumberCell</string>
            <key>label</key>
            <string>按钮数量（1–30）</string>
            <key>key</key>
            <string>ToolbarButtonCount</string>
            <key>default</key>
            <integer>7</integer>
            <key>PostNotification</key>
            <string>com.xiaofei.wxkeyboardtoolbar/preferences.changed</string>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSNumberCell</string>
            <key>label</key>
            <string>左右边距 pt（0–200）</string>
            <key>key</key>
            <string>ToolbarMargin</string>
            <key>default</key>
            <integer>0</integer>
            <key>PostNotification</key>
            <string>com.xiaofei.wxkeyboardtoolbar/preferences.changed</string>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
            <key>label</key>
            <string>高级</string>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSSwitchCell</string>
            <key>label</key>
            <string>启用按钮数量覆盖</string>
            <key>key</key>
            <string>EnableCountOverride</string>
            <key>default</key>
            <true/>
            <key>PostNotification</key>
            <string>com.xiaofei.wxkeyboardtoolbar/preferences.changed</string>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSSwitchCell</string>
            <key>label</key>
            <string>调试日志</string>
            <key>key</key>
            <string>DebugLog</string>
            <key>default</key>
            <false/>
            <key>PostNotification</key>
            <string>com.xiaofei.wxkeyboardtoolbar/preferences.changed</string>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSTextFieldCell</string>
            <key>label</key>
            <string>精确工具栏类名（可选）</string>
            <key>key</key>
            <string>ToolbarClassName</string>
            <key>default</key>
            <string></string>
            <key>PostNotification</key>
            <string>com.xiaofei.wxkeyboardtoolbar/preferences.changed</string>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
            <key>footerText</key>
            <string>开启调试日志后，插件会把微信输入法的视图层级打到系统日志，用于确认工具栏真实类名。</string>
        </dict>
    </array>
</dict>
</plist>
