<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>title</key>
	<string>微信输入法工具栏增强</string>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>header</key>
			<string>总开关</string>
			<key>footerText</key>
			<string>修改后无需重启, 切换一次键盘或收起再展开工具栏即可生效。</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>defaults</key>
			<string>com.wetypeplus</string>
			<key>key</key>
			<string>enabled</string>
			<key>default</key>
			<true/>
			<key>label</key>
			<string>启用本插件</string>
		</dict>

		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>header</key>
			<string>工具栏按钮数量</string>
			<key>footerText</key>
			<string>解除原版最多 7 个的限制, 范围 1-20。若 App 内添加按钮的入口仍受限制, 请在微信输入法 App 的键盘设置里添加到上限后再调整。</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSliderCell</string>
			<key>defaults</key>
			<string>com.wetypeplus</string>
			<key>key</key>
			<string>maxButtons</string>
			<key>default</key>
			<integer>20</integer>
			<key>min</key>
			<integer>1</integer>
			<key>max</key>
			<integer>20</integer>
			<key>interval</key>
			<integer>1</integer>
			<key>isVertical</key>
			<false/>
			<key>showValue</key>
			<true/>
			<key>leftText</key>
			<string>1</string>
			<key>rightText</key>
			<string>20</string>
			<key>label</key>
			<string>最多按钮数</string>
		</dict>

		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>header</key>
			<string>间距与边距</string>
			<key>footerText</key>
			<string>取值 0 表示不修改(保持原版)。按钮间距建议 4-16; 左右边距建议 0-24。</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSliderCell</string>
			<key>defaults</key>
			<string>com.wetypeplus</string>
			<key>key</key>
			<string>hSpacing</string>
			<key>default</key>
			<integer>0</integer>
			<key>min</key>
			<integer>0</integer>
			<key>max</key>
			<integer>40</integer>
			<key>interval</key>
			<integer>1</integer>
			<key>isVertical</key>
			<false/>
			<key>showValue</key>
			<true/>
			<key>label</key>
			<string>按钮之间的间距</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSliderCell</string>
			<key>defaults</key>
			<string>com.wetypeplus</string>
			<key>key</key>
			<string>leftMargin</string>
			<key>default</key>
			<integer>0</integer>
			<key>min</key>
			<integer>0</integer>
			<key>max</key>
			<integer>40</integer>
			<key>interval</key>
			<integer>1</integer>
			<key>isVertical</key>
			<false/>
			<key>showValue</key>
			<true/>
			<key>label</key>
			<string>左边距</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSliderCell</string>
			<key>defaults</key>
			<string>com.wetypeplus</string>
			<key>key</key>
			<string>rightMargin</string>
			<key>default</key>
			<integer>0</integer>
			<key>min</key>
			<integer>0</integer>
			<key>max</key>
			<integer>40</integer>
			<key>interval</key>
			<integer>1</integer>
			<key>isVertical</key>
			<false/>
			<key>showValue</key>
			<true/>
			<key>label</key>
			<string>右边距</string>
		</dict>

		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>header</key>
			<string>诊断</string>
			<key>footerText</key>
			<string>开启后插件会向系统日志输出内部类名/方法名(可用 Console 或 idevicesyslog 查看), 便于精确适配微信输入法新版本。</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>defaults</key>
			<string>com.wetypeplus</string>
			<key>key</key>
			<string>debugLog</string>
			<key>default</key>
			<false/>
			<key>label</key>
			<string>诊断日志</string>
		</dict>
	</array>
</dict>
</plist>
